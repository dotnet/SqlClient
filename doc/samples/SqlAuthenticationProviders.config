<!--
  Merge into an application's app.config. The public handler lives in Abstractions
  and is forwarded from SqlClient, preserving this assembly-qualified name.
  Replace the provider type with an application-defined SqlAuthenticationProvider.
-->
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" />
  </configSections>
  <SqlClientAuthenticationProviders>
    <providers>
      <add name="active directory default" type="ExampleAuthenticationProvider, ExampleApp" />
    </providers>
  </SqlClientAuthenticationProviders>
</configuration>
