<!--
  Merge this section declaration and provider registration into an application's app.config.
  The handler is public in Abstractions and forwarded from SqlClient, so its original
  assembly-qualified name remains valid. Replace the example provider type and assembly
  with an application-defined SqlAuthenticationProvider that supports the configured method.
-->
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" />
  </configSections>
  <SqlClientAuthenticationProviders>
    <providers>
      <add name="active directory default" type="ExampleAuthenticationProvider, ExampleApp" />
    </providers>
  </SqlClientAuthenticationProviders>
</configuration>
