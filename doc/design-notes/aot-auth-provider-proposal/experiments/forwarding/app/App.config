<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders" type="Owner.AuthSection, Owner" />
  </configSections>
  <SqlClientAuthenticationProviders applicationClientId="11111111-2222-3333-4444-555555555555" useWamBroker="false">
    <providers>
      <add name="active directory interactive" type="My.Provider, My.Assembly" />
    </providers>
  </SqlClientAuthenticationProviders>
</configuration>
