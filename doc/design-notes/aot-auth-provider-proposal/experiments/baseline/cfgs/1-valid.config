<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections><section name="SqlClientAuthenticationProviders" type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" /></configSections>
  <SqlClientAuthenticationProviders applicationClientId="11111111-2222-3333-4444-555555555555" useWamBroker="false"><providers><add name="active directory interactive" type="MyProvider, app" /></providers></SqlClientAuthenticationProviders>
</configuration>
