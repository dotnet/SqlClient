<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The repository NuGet.config maps SqlClient family packages to the local packages/ feed. The
    harness measures the published packages, so every package comes from the governed feed here.
  -->
  <packageSources>
    <clear />
    <add key="governed" value="https://sqlclientdrivers.pkgs.visualstudio.com/public/_packaging/sqlclient/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="governed">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
