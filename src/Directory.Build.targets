<Project>
  <!--
    ReferenceType is compared positively (== 'Project' or == 'Package') everywhere it is consumed,
    so an unrecognized value would silently select neither branch and produce confusing downstream
    errors. Fail fast instead.
  -->
  <Target Name="ValidateReferenceType"
          BeforeTargets="Restore;BeforeBuild">
    <PropertyGroup>
      <_ReferenceTypeIsValid>false</_ReferenceTypeIsValid>
      <_ReferenceTypeIsValid Condition="'$(ReferenceType)' == 'Project'">true</_ReferenceTypeIsValid>
      <_ReferenceTypeIsValid Condition="'$(ReferenceType)' == 'Package'">true</_ReferenceTypeIsValid>
    </PropertyGroup>
    <Error Condition="'$(_ReferenceTypeIsValid)' == 'false'"
           Text="Invalid ReferenceType '$(ReferenceType)'. Allowed values are 'Project' and 'Package'." />
  </Target>

  <!--
    Confirm that, when analysis is enabled, the build produced the SARIF file(s) that we expect.
    Each src/ project that is built should produce a SARIF log whose path is specified by the
    ErrorLog property defined in src/Directory.Build.props.  We perform this check here, rather
    than post-build, because the build.proj targets may build multiple projects, and the SARIF paths
    are difficult to predict.
  -->
  <Target Name="VerifyRoslynAnalysisLog"
          AfterTargets="CoreCompile"
          Condition="'$(EnableAnalyzers)' == 'true'">
    <Error Condition="'$(ErrorLog)' == ''"
           Text="Roslyn analysis did not configure an ErrorLog for $(MSBuildProjectFullPath)." />
    <Error Condition="'$(ErrorLog)' != '' AND !Exists('$(ErrorLog)')"
           Text="Roslyn analysis did not produce the expected SARIF log: $(ErrorLog)" />
  </Target>
</Project>
