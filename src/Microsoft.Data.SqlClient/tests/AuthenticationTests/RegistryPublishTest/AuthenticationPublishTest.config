<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient.Extensions.Abstractions" />
  </configSections>
  <SqlClientAuthenticationProviders
      initializerType="Microsoft.Data.SqlClient.ConfiguredInitializer, Microsoft.Data.SqlClient.Extensions.Azure">
    <providers>
      <add name="Active Directory Integrated"
           type="Microsoft.Data.SqlClient.ConfiguredProvider, Microsoft.Data.SqlClient.Extensions.Azure" />
    </providers>
  </SqlClientAuthenticationProviders>
</configuration>
