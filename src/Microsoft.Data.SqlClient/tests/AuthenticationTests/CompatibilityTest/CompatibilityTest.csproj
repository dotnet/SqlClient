<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reuse the type names in the existing scenario configuration files. -->
    <AssemblyName>AuthenticationConfigurationTest</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AppConfig>../ConfigurationTest/app.config</AppConfig>
    <OutputPath>bin/$(ReferenceType)/$(CompatibilityPackageVersion)/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReferenceType)' == 'Project'">
    <ProjectReference Include="$(RepoRoot)src/Microsoft.Data.SqlClient/src/Microsoft.Data.SqlClient.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Microsoft.Data.SqlClient.Extensions/Azure/src/Azure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReferenceType)' == 'Package'">
    <!-- An exact baseline is intentional: floating servicing versions invalidate comparisons. -->
    <PackageReference Include="Microsoft.Data.SqlClient">
      <VersionOverride Condition="'$(CompatibilityPackageVersion)' != ''">[$(CompatibilityPackageVersion)]</VersionOverride>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure">
      <VersionOverride Condition="'$(CompatibilityPackageVersion)' != ''">[$(CompatibilityPackageVersion)]</VersionOverride>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../ConfigurationTest/*.config" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
