    <!--
      All file paths are relative to the artifacts directory created by the build, so
      the pack flow sets NuspecBasePath to that artifacts directory.

      The pack flow supplies $ReferenceType$ to indicate which build output layout
      should be packaged.
    -->

    <!-- Lib Binaries ================================================== -->
    <!-- lib/net462 - These contain the implementation -->
    <!--
      Unlike the modern target frameworks, whose lib folder holds a PlatformNotSupportedException
      placeholder, net462 puts the real implementation here.  Two reasons:

        * .NET Framework has no runtime RID resolution.  A .NET Core host reads runtimes/<rid>
          assets from deps.json and picks one for the current platform, but .NET Framework produces
          no deps.json.  RID assets are selected at restore time only, and only when the consuming
          project sets a RuntimeIdentifier, which a .NET Framework project does not do by default.
          A packages.config project ignores runtimes/ entirely.  So for most consumers lib/ is the
          only folder that is ever read, and a placeholder there would compile against ref/net462
          and then throw at runtime.

        * There is nothing to disambiguate.  .NET Framework runs on Windows only, so the single
          OS-specific build is correct for every consumer, and the OS-agnostic lib folder can hold
          it without being wrong for anyone.

      The localized resources below are also here and nowhere else, so lib/net462 is the only
      location that yields translated error messages.

      This asymmetry between net462 and the modern target frameworks is expected to go away:
      https://github.com/dotnet/SqlClient/pull/4673 drops the RID-specific DLLs and packs the real
      implementation into lib/ for every target framework.
    -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\Microsoft.Data.SqlClient.dll" target="lib\net462\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\Microsoft.Data.SqlClient.pdb" target="lib\net462\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\Microsoft.Data.SqlClient.xml" target="lib\net462\" exclude="" />

    <!-- lib/net462 Localized Resources -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\cs\Microsoft.Data.SqlClient.resources.dll" target="lib\net462\cs\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\de\Microsoft.Data.SqlClient.resources.dll" target="lib\net462\de\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\es\Microsoft.Data.SqlClient.resources.dll" target="lib\net462\es\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\fr\Microsoft.Data.SqlClient.resources.dll" target="lib\net462\fr\" exclude="" />
