    <!-- Runtime Binaries ============================================== -->
    <!-- @TODO: This is a temporary measure - removing the not support DLLs will come next -->

    <!-- runtimes/win/lib/net462 -->
    <!--
      Byte-for-byte the same assembly that is packed into lib/net462, from the same source path.
      .NET Framework runs on Windows only, so there is no second RID this copy distinguishes the
      implementation from, and a consumer that resolves no RID asset falls back to lib/net462
      anyway.  Note also that the localized resources are packed into lib/net462 alone, so a
      consumer bound to this copy gets untranslated error messages.

      @TODO: We include the impl version in the lib folder - is the runtimes version necessary?
      https://github.com/dotnet/SqlClient/pull/4673 answers no, and removes every runtimes/ entry
      from this file.
    -->
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\Microsoft.Data.SqlClient.dll" target="runtimes\win\lib\net462\" exclude="" />
    <file src="Microsoft.Data.SqlClient\$ReferenceType$-$Configuration$\net462\Microsoft.Data.SqlClient.pdb" target="runtimes\win\lib\net462\" exclude="" />

