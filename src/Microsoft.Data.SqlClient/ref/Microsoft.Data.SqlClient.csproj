<Project Sdk="Microsoft.NET.Sdk">
  <!-- General Properties ============================================== -->
  <PropertyGroup>
    <AssemblyName>Microsoft.Data.SqlClient</AssemblyName>
    <TargetFrameworks>net462;net8.0;net9.0;netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Compiler Options ================================================ -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Opt into the documentation snippet compile inputs declared in src/Directory.Build.targets. -->
    <IncludesDocumentationSnippets>true</IncludesDocumentationSnippets>
  </PropertyGroup>

  <!-- Versioning ====================================================== -->
  <!-- Import our Versions.props unless it was already imported (e.g. by Directory.Packages.props
       in Package mode).  The guard property inside Versions.props makes this a no-op on the
       second import. -->
  <Import Project="../Versions.props" Condition="'$(SqlClientVersionsImported)' != 'true'" />
  <PropertyGroup>
    <AssemblyVersion>$(SqlClientAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SqlClientFileVersion)</FileVersion>
    <Version>$(SqlClientPackageVersion)</Version>
  </PropertyGroup>

  <!-- CLS Compliance ================================================== -->
  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Strong name signing ============================================= -->
  <!-- This is done in Directory.Build.props -->

  <!-- Build Output ==================================================== -->
  <PropertyGroup>
    <!-- @TODO: Move to directory.build.props? -->
    <ArtifactPath>$(RepoRoot)artifacts/</ArtifactPath>

    <!--
      MSBuild will add the target framework to the end of this path by default. Telling it not to
      is possible but also requires specifying the IntermediateOutputPath. So while it would be
      nice to have a flatter directory structure, it's more hassle than its worth.
    -->
    <OutputPath>$(ArtifactPath)$(AssemblyName).ref/$(ReferenceType)-$(Configuration)/</OutputPath>
  </PropertyGroup>


  <!-- Trim Docs for IntelliSense ====================================== -->
  <!--
    It has been determined that including the remarks section in IntelliSense docs looks bad in
    Visual Studio. So, before we generate the ref binaries, we trim off the remarks tags. We leave
    them in the xml files, though, because those are the source for the docs site, which needs to
    have the full documentation.
  -->
  <!--
    Forward slashes because this path is also passed through to pwsh, where a backslash is an
    escape character rather than a separator on non-Windows hosts.  Windows accepts either.
  -->
  <PropertyGroup>
    <TrimDocsScript>$(RepoRoot)tools/intellisense/TrimDocs.ps1</TrimDocsScript>
  </PropertyGroup>

  <!-- Verifies that dotnet local tools have been restored (pwsh is required for doc trimming). -->
  <Target Name="_CheckPwshToolRestored">
    <Exec Command="dotnet tool run pwsh -- -Version"
          WorkingDirectory="$(RepoRoot)"
          ConsoleToMsBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_PwshExitCode" />
    </Exec>
    <Error Condition="'$(_PwshExitCode)' != '0'"
           Text="The 'pwsh' dotnet local tool is not available. Run 'dotnet tool restore' from the repository root before building." />
  </Target>

  <!--
    Produces two documentation files: the trimmed one the package's ref/ folder ships, and an
    untrimmed copy under untrimmed/ that the API docs pipeline consumes.

    The compiler's own output in the intermediate directory is never modified.  That matters
    because an isolated analyzer build redirects bin but deliberately shares obj (see build.proj),
    so rewriting the intermediate file in place would leave the shared copy trimmed and a later
    real build would publish trimmed text as though it were the full text.
  -->
  <Target Name="TrimDocsForIntelliSense"
          AfterTargets="CoreCompile"
          BeforeTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="_CheckPwshToolRestored"
          Inputs="$(DocumentationFile);$(TrimDocsScript)"
          Outputs="$(IntermediateOutputPath)trimmed/$(TargetName).xml"
          Condition="'$(IsCrossTargetingBuild)' != 'true' AND '$(GenerateDocumentationFile)' == 'true'">

    <MakeDir Directories="$(IntermediateOutputPath)trimmed" />

    <PropertyGroup>
      <PowerShellCommand>
        dotnet tool run pwsh --
          -NonInteractive
          -NoProfile
          -ExecutionPolicy Unrestricted
          -Command "$(TrimDocsScript) -inputFile '$(DocumentationFile)' -outputFile '$(IntermediateOutputPath)trimmed/$(TargetName).xml'"
      </PowerShellCommand>

      <!-- Convert more than one whitespace character into one space -->
      <PowerShellCommand>$([System.Text.RegularExpressions.Regex]::Replace($(PowerShellCommand), "\s+", " "))</PowerShellCommand>
    </PropertyGroup>

    <Message Text=">>> Trimming documentation file from generated documentation file: $(PowerShellCommand)"/>
    <Exec Command="$(PowerShellCommand)" ConsoleToMsBuild="true" />
  </Target>

  <!--
    Points the documentation file that CopyFilesToOutputDirectory publishes at the trimmed copy.

    Redirecting the copy source rather than overwriting the copy result is what makes this survive
    an incremental build: that task skips unchanged files by comparing timestamp and size, so a
    trimmed file written over its output would differ from the intermediate source and be replaced
    with the untrimmed text on the next build.

    Deliberately has no Inputs/Outputs.  It must run on every build, including those where the trim
    itself was up to date, or the untrimmed intermediate file would be published instead.
  -->
  <Target Name="PublishTrimmedDocsForIntelliSense"
          DependsOnTargets="TrimDocsForIntelliSense"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(IsCrossTargetingBuild)' != 'true' AND '$(GenerateDocumentationFile)' == 'true'">

    <ItemGroup>
      <DocFileItem Remove="@(DocFileItem)" />
      <DocFileItem Include="$(IntermediateOutputPath)trimmed/$(TargetName).xml" />
    </ItemGroup>
  </Target>

  <!--
    Publishes the untrimmed documentation beside the trimmed copy.

    Keyed on the output path rather than on intermediate state, so a build writing to a different
    output directory produces its own copy instead of being considered up to date because some
    earlier build wrote one elsewhere.
  -->
  <Target Name="CopyUntrimmedDocsForApiDocs"
          AfterTargets="CopyFilesToOutputDirectory"
          Inputs="$(DocumentationFile)"
          Outputs="$(OutputPath)untrimmed/$(TargetName).xml"
          Condition="'$(IsCrossTargetingBuild)' != 'true' AND '$(GenerateDocumentationFile)' == 'true'">

    <Copy SourceFiles="$(DocumentationFile)"
          DestinationFiles="$(OutputPath)untrimmed/$(TargetName).xml"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- References ====================================================== -->
  <!-- Reference to Abstractions -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/Microsoft.Data.SqlClient.Extensions/Abstractions/src/Abstractions.csproj"
                      Condition="'$(ReferenceType)' != 'Package'" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Abstractions"
                      Condition="'$(ReferenceType)' == 'Package'" />
  </ItemGroup>
  <!-- .NET Framework and .NET Standard 2.0 don't need to reference SqlServer. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net462' AND '$(TargetFramework)' != 'netstandard2.0'">
    <ProjectReference Include="$(RepoRoot)src/Microsoft.SqlServer.Server/Microsoft.SqlServer.Server.csproj"
                      Condition="'$(ReferenceType)' != 'Package'" />
    <PackageReference Include="Microsoft.SqlServer.Server"
                      Condition="'$(ReferenceType)' == 'Package'" />
  </ItemGroup>

  <!-- References for netframework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.EnterpriseServices" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Xml" />

    <PackageReference Include="Microsoft.Bcl.Cryptography" />
    <PackageReference Include="Microsoft.Data.SqlClient.SNI" ExcludeAssets="compile" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

  <!-- References for netcore -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net462' AND '$(TargetFramework)' != 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.Cryptography" />
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- References for netstandard -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.Cryptography" />
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>
</Project>
