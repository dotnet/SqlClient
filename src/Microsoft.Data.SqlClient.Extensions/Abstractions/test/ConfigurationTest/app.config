<?xml version="1.0" encoding="utf-8"?>
<!--
  Tests the current authentication configuration section. The initializer registers a
  device-code provider, and the section registers an interactive provider; both must take
  precedence over Azure defaults and application registrations. The disabled scenario reuses
  this file to verify that disabling configuration loading prevents both registrations.
-->
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" />
  </configSections>
  <SqlClientAuthenticationProviders initializerType="TestInitializer, AuthenticationConfigurationTest">
    <providers>
      <add name="active directory interactive" type="TestProvider, AuthenticationConfigurationTest" />
    </providers>
  </SqlClientAuthenticationProviders>
</configuration>
