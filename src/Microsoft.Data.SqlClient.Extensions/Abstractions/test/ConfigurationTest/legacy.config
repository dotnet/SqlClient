<?xml version="1.0" encoding="utf-8"?>
<!--
  Tests fallback to the legacy SqlAuthenticationProviders section when the current section
  is absent. Initializer and configured provider registrations must retain the same
  precedence over Azure defaults and application registrations as the current section.
-->
<configuration>
  <configSections>
    <section name="SqlAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" />
  </configSections>
  <SqlAuthenticationProviders initializerType="TestInitializer, AuthenticationConfigurationTest">
    <providers>
      <add name="active directory interactive" type="TestProvider, AuthenticationConfigurationTest" />
    </providers>
  </SqlAuthenticationProviders>
</configuration>
