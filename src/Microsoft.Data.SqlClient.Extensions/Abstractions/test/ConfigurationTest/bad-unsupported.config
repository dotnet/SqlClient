<?xml version="1.0" encoding="utf-8"?>
<!--
  Tests bootstrap failure when a configured provider rejects its authentication method.
  UnsupportedProvider exists but reports no supported methods: GetProvider must return null
  and SetProvider must return false. The cached failure must identify the provider in trace diagnostics.
-->
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" />
  </configSections>
  <SqlClientAuthenticationProviders>
    <providers>
      <add name="active directory default" type="UnsupportedProvider, AuthenticationConfigurationTest" />
    </providers>
  </SqlClientAuthenticationProviders>
</configuration>
