<?xml version="1.0" encoding="utf-8"?>
<!--
  Tests bootstrap failure when the configured initializer type does not exist. MissingInitializer
  is deliberately undefined: GetProvider must return null and SetProvider must return false.
  The failure must remain cached and identify the missing type in subsequent trace diagnostics.
-->
<configuration>
  <configSections>
    <section name="SqlClientAuthenticationProviders"
             type="Microsoft.Data.SqlClient.SqlClientAuthenticationProviderConfigurationSection, Microsoft.Data.SqlClient" />
  </configSections>
  <SqlClientAuthenticationProviders initializerType="MissingInitializer, AuthenticationConfigurationTest" />
</configuration>
