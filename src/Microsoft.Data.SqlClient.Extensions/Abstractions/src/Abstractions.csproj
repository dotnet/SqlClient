<Project Sdk="Microsoft.NET.Sdk">
  <!-- General Properties ============================================== -->
  <PropertyGroup>
    <AssemblyName>Microsoft.Data.SqlClient.Extensions.Abstractions</AssemblyName>
    <!-- Preserve legacy compatibility while enabling modern trimming and AOT analysis. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- Compiler Options ================================================ -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Opt into the documentation snippet compile inputs declared in src/Directory.Build.targets. -->
    <IncludesDocumentationSnippets>true</IncludesDocumentationSnippets>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Microsoft.Data.SqlClient</RootNamespace>
  </PropertyGroup>

  <!-- CLS Compliance ================================================== -->
  <ItemGroup>
    <!-- Our API is CLS Compliant. -->
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Versioning ====================================================== -->
  <!-- This package is part of the SqlClient family and shares the SqlClient version.  The
       SqlClient* version properties are provided by src/Directory.Build.props, which imports the
       canonical Microsoft.Data.SqlClient/Versions.props for every project. -->
  <PropertyGroup>
    <AssemblyVersion>$(SqlClientAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SqlClientFileVersion)</FileVersion>
    <Version>$(SqlClientPackageVersion)</Version>
  </PropertyGroup>

  <!-- Strong name signing ============================================= -->
  <!-- This is done in Directory.Build.props -->
  <ItemGroup Condition="'$(SigningKeyPath)' == ''">
    <InternalsVisibleTo Include="$(AssemblyName).Test" />
  </ItemGroup>

  <!-- Build Output ==================================================== -->
  <PropertyGroup>
    <ArtifactPath>$(RepoRoot)artifacts/</ArtifactPath>
    <OutputPath>$(ArtifactPath)$(AssemblyName)/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <!-- NuGet Package Config ============================================ -->
  <!-- See: https://learn.microsoft.com/en-us/nuget/reference/msbuild-targets#pack-target -->
  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <Title>Microsoft.Data.SqlClient.Extensions.Abstractions</Title>
    <Authors>Microsoft</Authors>
    <Company>Microsoft Corporation</Company>
    <Description>Microsoft.Data.SqlClient Extensions Abstractions</Description>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageTags>sqlclient microsoft.data.sqlclient extensions abstractions</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dotnet/SqlClient</RepositoryUrl>
    <PackageProjectUrl>https://aka.ms/sqlclientproject</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageIcon>dotnet.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)/tools/icons/dotnet.png" Pack="true" PackagePath="/" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <!-- References ====================================================== -->
  <!-- Reference to Logging  -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)/src/Microsoft.Data.SqlClient.Internal/Logging/src/Logging.csproj"
                      Condition="'$(ReferenceType)' == 'Project'" />
    <PackageReference Include="Microsoft.Data.SqlClient.Internal.Logging"
                      Condition="'$(ReferenceType)' == 'Package'" />
    <PackageReference Include="System.Configuration.ConfigurationManager"
                      PrivateAssets="contentfiles;build;buildTransitive;analyzers" />
  </ItemGroup>

  <!-- CodeGen Targets ================================================= -->
  <ItemGroup>
    <!-- Match AuthenticationStrings' ResourceManager base name for neutral and localized resources. -->
    <EmbeddedResource Update="Resources/Strings*.resx">
      <LogicalName>Microsoft.Data.SqlClient.Authentication.%(Filename).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(ToolsDir)targets\GenerateThisAssemblyCs.targets" />
</Project>
